GITEA_WEBHOOK_SECRET=replace-with-webhook-secret
BOB_ADMIN_TOKEN=replace-with-admin-token
BOB_RUNNER_TOKEN=replace-with-runner-token
BOB_ALLOWED_REPOSITORIES=Iron-Eagle-Security-Ltd/field-compliance-manager
BOB_STATE_DIR=./bob-data
BOB_WORKFLOW_MODE=local
SUPABASE_URL=https://dotczcyyzgabmtmnglqj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
GITLAB_READ_TOKEN=replace-with-project-scoped-read-only-token
GITLAB_WRITE_TOKEN=replace-with-separate-write-token-only-if-write_bob_chat-is-enabled
GITLAB_PROJECT_ID=replace-with-approved-gitlab-project-id
GITLAB_ALLOWED_PROJECTS=replace-with-approved-gitlab-project-id
FCM_API_URL=https://api.fcmanager.co.nz
FCM_API_TOKEN=replace-with-fcm-api-bearer-token
# Server-side CarJam Developer Connection credentials. Do not expose these to web/mobile builds.
# Automated persistence must stay disabled until CarJam provides written storage authorization.
CARJAM_API_KEY=replace-with-carjam-developer-connection-key
CARJAM_STORAGE_AUTHORIZATION_REFERENCE=replace-with-written-carjam-approval-reference
# Bounded sequential refresh defaults; tune only within the provider's licensed rate limits.
CARJAM_BATCH_LIMIT=25
CARJAM_MIN_INTERVAL_MS=1250
CARJAM_REFRESH_AFTER_DAYS=30
API_URL=https://api.fcmanager.co.nz
API_TOKEN=replace-with-fcm-api-bearer-token
RUNPOD_API=replace-with-runpod-api-key
RUNPOD_API_URL=https://api.runpod.ai/v2/katqqnmds1dphs
# Optional dedicated recognition-capture endpoint; keep its key separate when provisioned.
RUNPOD_CAPTURE_API_KEY=replace-with-capture-endpoint-key
RUNPOD_CAPTURE_API_URL=https://api.runpod.ai/v2/replace-with-capture-endpoint-id
