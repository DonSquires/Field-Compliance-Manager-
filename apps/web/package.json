{
  "name": "@fcm/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "holidays:generate": "node scripts/generate-nz-holidays.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci-smoke": "playwright test e2e/admin-hub-dispatch.spec.ts e2e/dr-bob-automation-geofence-module.spec.ts e2e/geofence-spine-map.spec.ts e2e/officer-module-entitlements.spec.ts --project=desktop-chromium --workers=1",
    "test:e2e:human": "playwright test e2e/dr-bob-human-test.spec.ts",
    "test:e2e:human:live": "HUMAN_TEST_LIVE=true playwright test e2e/dr-bob-human-test.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "lint": "tsc --noEmit && tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "read-excel-file": "^9.3.10",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "date-holidays": "^3.36.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
