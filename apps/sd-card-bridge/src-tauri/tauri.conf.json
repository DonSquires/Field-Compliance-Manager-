{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FCM SD Card Bridge",
  "version": "0.1.5",
  "identifier": "nz.co.fieldcompliance.sd-card-bridge",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "FCM SD Card Bridge", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 600 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:" } },
  "bundle": { "active": true, "targets": "nsis", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "windows": { "wix": { "language": ["en-US"] } } },
  "plugins": { "deep-link": { "desktop": { "schemes": ["fcm-bridge"] } } }
}