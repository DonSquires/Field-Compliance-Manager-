{
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "vite"
        },
        "fcm-api": {
            "root": "services/fcm-api"
        },
        "fcm-inference": {
            "root": "services/fcm-inference"
        },
        "fcm-planner": {
            "root": "services/fcm-planner"
        },
        "fcm-solver": {
            "root": "services/fcm-solver"
        },
        "fcm-voice": {
            "root": "services/fcm-voice"
        },
        "vision": {
            "root": "services/vision"
        }
    },
    "rewrites": [
        {
            "source": "/api/fcm-inference(/.*)?",
            "destination": {
                "type": "service",
                "service": "fcm-inference"
            }
        },
        {
            "source": "/api/fcm-planner(/.*)?",
            "destination": {
                "type": "service",
                "service": "fcm-planner"
            }
        },
        {
            "source": "/api/fcm-solver(/.*)?",
            "destination": {
                "type": "service",
                "service": "fcm-solver"
            }
        },
        {
            "source": "/api/fcm-voice(/.*)?",
            "destination": {
                "type": "service",
                "service": "fcm-voice"
            }
        },
        {
            "source": "/api/fcm-api(/.*)?",
            "destination": {
                "type": "service",
                "service": "fcm-api"
            }
        },
        {
            "source": "/api/vision(/.*)?",
            "destination": {
                "type": "service",
                "service": "vision"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "web"
            }
        }
    ]
}
