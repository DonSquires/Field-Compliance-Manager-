limit_req_zone $binary_remote_addr zone=bob_builder_api:10m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name ${BOB_CONTROL_PLANE_HOST};

    ssl_certificate /etc/letsencrypt/live/${BOB_CONTROL_PLANE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BOB_CONTROL_PLANE_HOST}/privkey.pem;

    client_max_body_size 1m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 900s;
    proxy_send_timeout 30s;

    location = /health {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
    }

    location ~ ^/api/bob/builder/jobs/[0-9a-f-]+/(advance|run)$ {
        limit_req zone=bob_builder_api burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass_request_headers on;
    }

    location / {
        return 404;
    }
}