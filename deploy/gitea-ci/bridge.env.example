# VPS path: /etc/fcm-gitea-ci/bridge.env — root:root 0600. Never commit the populated file.
GITHUB_REPOSITORY=DonSquires/Field-Compliance-Manager-
# Needs commit-status write and contents read on GITHUB_REPOSITORY (a fine-grained PAT is enough).
GITHUB_TOKEN=
# Gitea is reached on the host port, not through Cloudflare.
GITEA_URL=http://127.0.0.1:3005
GITEA_REPOSITORY=Iron-Eagle-Security-Ltd/field-compliance-manager
# Gitea token with write:repository for the repository above.
GITEA_TOKEN=
STATE_DIR=/var/lib/fcm-gitea-ci
# Refresh the live Atlas on the host after main passes. Reads only SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY from ATLAS_ENV_FILE and passes them to a node:22 container.
ATLAS_REFRESH=1
ATLAS_ENV_FILE=/opt/fcm/.env
