# Copy to deploy/laptop-worker/laptop-worker.env (gitignored, never commit the populated file).
# These are the same values already configured on the VPS's /opt/fcm/.env — copy them across.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKLOAD_SIGNING_SECRET=
VISION_INGESTION_URL=
# Generate a unique 32+ character value; configure the VPS LOCAL_GPU_INFERENCE_API_KEY to the same value.
LAPTOP_INFERENCE_API_KEY=
# Optional paid fallback only. The laptop GPU remains primary.
RUNPOD_API_KEY=
# Optional, read by scripts/bob-gpu-link/laptop-tailscale.ps1 (Bob's GPU link + terminal): the VPS's Tailscale
# address (default 100.85.95.104) and the Ollama models to keep pulled (default qwen2.5:7b,qwen2.5-coder:7b).
# BOB_VPS_TAILSCALE_IP=100.85.95.104
# BOB_GPU_MODELS=qwen2.5:7b,qwen2.5-coder:7b,qwen2.5-coder:14b
