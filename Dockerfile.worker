FROM mcr.microsoft.com/playwright:v1.62.1-jammy

RUN apt-get update \
	&& apt-get install -y --no-install-recommends git \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /opt/bob
# Every module reachable from the worker entrypoints must be copied here;
# test/worker-image-manifest.test.js fails when this list falls behind.
COPY assessment-manifest.js /opt/bob/assessment-manifest.js
COPY builder-path-policy.js /opt/bob/builder-path-policy.js
COPY builder-verification-outcome.js /opt/bob/builder-verification-outcome.js
COPY builder-data-path-gate.js /opt/bob/builder-data-path-gate.js
COPY builder-ts-delta-gate.js /opt/bob/builder-ts-delta-gate.js
COPY frontend-worker.js /opt/bob/frontend-worker.js
COPY backend-worker.js /opt/bob/backend-worker.js
COPY security-worker.js /opt/bob/security-worker.js
COPY supabase/functions/_shared/builder-backend-engineer.js /opt/bob/supabase/functions/_shared/builder-backend-engineer.js
COPY supabase/functions/_shared/builder-model-adapter.js /opt/bob/supabase/functions/_shared/builder-model-adapter.js
COPY supabase/functions/_shared/builder-repository-context.js /opt/bob/supabase/functions/_shared/builder-repository-context.js
COPY apps/web/package.json apps/web/package-lock.json /opt/bob/web-package/
RUN cd /opt/bob/web-package \
	&& npm ci \
	&& mv node_modules /opt/bob/web-node_modules \
	&& ln -s /opt/bob/web-node_modules /opt/bob/node_modules \
	&& rm -rf /opt/bob/web-package

RUN mkdir -p /workspace \
	&& chown -R 1000:1000 /opt/bob /workspace
USER 1000:1000

WORKDIR /workspace
